{
  // Standalone, assets-only Worker for the manta site on its own dedicated
  // domain. One directory (`./web`) holds the homepage at the root and the
  // built MkDocs site under `docs/`, so:
  //     mantapilot.org/         -> web/index.html      (homepage)
  //     mantapilot.org/docs/    -> web/docs/index.html (MkDocs)
  // No Worker script (`main`) is needed — Cloudflare serves the assets
  // directly. Build the docs first with `mkdocs build` (outputs web/docs).
  "name": "manta-docs",
  "compatibility_date": "2026-06-17",

  "assets": {
    "directory": "./web",
    // Serve web/404.html on unknown paths.
    "not_found_handling": "404-page",
    // MkDocs uses directory URLs (/docs/page/ -> /docs/page/index.html).
    "html_handling": "auto-trailing-slash"
  },

  // Serve on the apex domain. The mantapilot.org zone must be active in this
  // Cloudflare account; `wrangler deploy` then provisions the DNS record and
  // TLS automatically. The host must match site_url in mkdocs.yml.
  "routes": [
    { "pattern": "mantapilot.org", "custom_domain": true }
  ]
}
