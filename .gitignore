# Build artifacts
build/
build_ci/
build_examples/
build_double/
dist/
*.o
*.a
*.so
*.dylib
*.dll

# Generated WASM build inputs (regenerated by TargetWasm — see
# web/README.md). The served runtime artifacts (.wasm/.mjs/.js/
# .descriptor.json) and build.sh stay tracked.
web/airplane/*_kernels.c
web/airplane/*_kernels.h
web/airplane/*_abi.c
web/quad/*_kernels.c
web/quad/*_kernels.h
web/quad/*_abi.c

# Per-design compiled bundles from the "build a Mako" spawn server —
# a content-addressed cache, always regenerable.
web/mako/builds/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# MkDocs build output (homepage web/index.html + web/404.html stay tracked)
web/docs/
site/

# Editor / IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
prompts/

# Local planning/audit notes — README is the only markdown tracked
ARCHITECTURE_AUDIT.md
ARCHITECTURE_TARGET.md
REFACTOR_PLAN.md

# In-repo working notes — not for the remote
memory/

*:Zone.Identifier
